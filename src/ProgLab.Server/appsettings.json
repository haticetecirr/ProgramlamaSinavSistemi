{
  "Urls": "http://localhost:5000",
  "Jwt": {
    "TokenLifetimeHours": 4
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
