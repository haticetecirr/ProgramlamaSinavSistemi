{
  "Server": {
    "Port": 5000
  },
  "Discovery": {
    "Enabled": true,
    "UdpPort": 47777,
    "ServerPort": 5000,
    "IntervalSeconds": 2
  },
  "ExamTimer": {
    "TimeSyncSeconds": 30
  },
  "Jwt": {
    "TokenLifetimeHours": 4
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
