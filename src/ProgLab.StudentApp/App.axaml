<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProgLab.StudentApp.ViewModels"
             xmlns:views="using:ProgLab.StudentApp.Views"
             x:Class="ProgLab.StudentApp.App"
             RequestedThemeVariant="Default">
  <!-- Hangi ViewModel için hangi ekranın gösterileceği burada eşlenir. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:LoginViewModel"><views:LoginView /></DataTemplate>
    <DataTemplate DataType="vm:FirstLoginViewModel"><views:FirstLoginView /></DataTemplate>
    <DataTemplate DataType="vm:ConnectViewModel"><views:ConnectView /></DataTemplate>
    <DataTemplate DataType="vm:LobbyViewModel"><views:LobbyView /></DataTemplate>
    <DataTemplate DataType="vm:ExamPaperViewModel"><views:ExamPaperView /></DataTemplate>
    <DataTemplate DataType="vm:SubmittedViewModel"><views:SubmittedView /></DataTemplate>
    <!-- Soru tipine göre şablon. Finalde kod sorusu şablonu buraya eklenir. -->
    <DataTemplate DataType="vm:MultipleChoiceQuestionViewModel"><views:MultipleChoiceQuestionView /></DataTemplate>
    <DataTemplate DataType="vm:ClassicQuestionViewModel"><views:ClassicQuestionView /></DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#EF5350" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.timer">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.timer.urgent">
      <Setter Property="Foreground" Value="#EF5350" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
