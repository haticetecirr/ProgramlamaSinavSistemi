<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProgLab.StudentApp.ViewModels"
             x:Class="ProgLab.StudentApp.Views.ExamPaperView"
             x:DataType="vm:ExamPaperViewModel">
  <DockPanel Margin="16">
    <!-- Üst: başlık, kalan süre, kayıt ve bağlantı durumu -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0">
        <TextBlock Classes="timer" Classes.urgent="{Binding IsUrgent}" Text="{Binding TimeText}" HorizontalAlignment="Right" />
        <TextBlock Text="kalan süre" Opacity="0.7" HorizontalAlignment="Right" />
      </StackPanel>
      <StackPanel Spacing="2">
        <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Description}" Opacity="0.8" TextWrapping="Wrap" IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding ConnectionText}" Opacity="0.7" />
        <TextBlock Text="{Binding SaveStatusText}" Foreground="#FFB300" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>

    <!-- Alt: mesajlar ve gezinme -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
      <Border IsVisible="{Binding IsClosed}" Padding="10" BorderBrush="#EF5350" BorderThickness="1" CornerRadius="4">
        <TextBlock Text="{Binding ClosedMessage}" TextWrapping="Wrap" />
      </Border>
      <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Lobiye dön" Command="{Binding BackToLobbyCommand}" AutomationProperties.Name="Lobiye dön" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Önceki" Command="{Binding PreviousCommand}" AutomationProperties.Name="Önceki soru" />
          <Button Content="Sonraki" Command="{Binding NextCommand}" AutomationProperties.Name="Sonraki soru" />
          <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" Opacity="0.7" Margin="8,0,0,0" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <Grid ColumnDefinitions="180,16,*">
      <!-- Sol: soru listesi -->
      <ListBox ItemsSource="{Binding Questions}" SelectedItem="{Binding CurrentQuestion}" AutomationProperties.Name="Soru listesi">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PaperQuestionViewModel">
            <StackPanel>
              <TextBlock Text="{Binding ListTitle}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StateText}" Opacity="0.7" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Sağ: soru; tipine göre şablon seçilir, süre bitince salt okunur -->
      <ScrollViewer Grid.Column="2">
        <ContentControl Content="{Binding CurrentQuestion}" IsEnabled="{Binding IsEditable}" />
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
