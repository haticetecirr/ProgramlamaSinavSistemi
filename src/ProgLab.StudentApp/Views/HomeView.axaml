<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProgLab.StudentApp.ViewModels"
             x:Class="ProgLab.StudentApp.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Classes="title" Text="{Binding Greeting}" HorizontalAlignment="Center" />
    <TextBlock Text="Giriş başarılı. Sınav listesi sonraki geliştirme aşamasında burada görünecek." HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
