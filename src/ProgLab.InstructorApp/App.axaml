<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProgLab.InstructorApp.ViewModels"
             xmlns:views="using:ProgLab.InstructorApp.Views"
             x:Class="ProgLab.InstructorApp.App"
             RequestedThemeVariant="Default">
  <!-- Hangi ViewModel için hangi ekranın gösterileceği burada eşlenir. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:LoginViewModel"><views:LoginView /></DataTemplate>
    <DataTemplate DataType="vm:ChangePasswordViewModel"><views:ChangePasswordView /></DataTemplate>
    <DataTemplate DataType="vm:ClassesViewModel"><views:ClassesView /></DataTemplate>
    <DataTemplate DataType="vm:QuestionBankViewModel"><views:QuestionBankView /></DataTemplate>
    <DataTemplate DataType="vm:QuestionEditorViewModel"><views:QuestionEditorView /></DataTemplate>
    <DataTemplate DataType="vm:CategoryDialogViewModel"><views:CategoryDialog /></DataTemplate>
    <DataTemplate DataType="vm:ExamListViewModel"><views:ExamListView /></DataTemplate>
    <DataTemplate DataType="vm:ExamEditorViewModel"><views:ExamEditorView /></DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#EF5350" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
