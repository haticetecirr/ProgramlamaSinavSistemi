<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProgLab.InstructorApp.ViewModels"
             x:Class="ProgLab.InstructorApp.Views.ResultsView"
             x:DataType="vm:ResultsViewModel">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding SummaryText}" Opacity="0.8" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="Sırala:" VerticalAlignment="Center" Opacity="0.7" />
        <RadioButton GroupName="resultSort" Content="Öğrenci no" IsChecked="{Binding SortByNumber}" AutomationProperties.Name="Öğrenci noya göre sırala" />
        <RadioButton GroupName="resultSort" Content="Ad" IsChecked="{Binding SortByName}" AutomationProperties.Name="Ada göre sırala" />
        <RadioButton GroupName="resultSort" Content="Puan" IsChecked="{Binding SortByScore}" AutomationProperties.Name="Puana göre sırala" />
        <RadioButton GroupName="resultSort" Content="Teslim saati" IsChecked="{Binding SortBySubmittedAt}" AutomationProperties.Name="Teslim saatine göre sırala" />
      </StackPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
      <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Listeye dön" Command="{Binding BackCommand}" AutomationProperties.Name="Listeye dön" />
        <Button Content="Yenile" Command="{Binding LoadCommand}" AutomationProperties.Name="Yenile" />
        <Button Classes="accent" Content="Cevapları aç" Command="{Binding OpenSubmissionCommand}" AutomationProperties.Name="Cevapları aç" />
      </StackPanel>
    </StackPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="110,*,130,160,70,70" Margin="12,0,12,4" Opacity="0.7">
      <TextBlock Text="Öğrenci no" />
      <TextBlock Grid.Column="1" Text="Ad soyad" />
      <TextBlock Grid.Column="2" Text="Durum" />
      <TextBlock Grid.Column="3" Text="Teslim saati" />
      <TextBlock Grid.Column="4" Text="Doğru" />
      <TextBlock Grid.Column="5" Text="Puan" />
    </Grid>

    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="Sonuçlar">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ResultRow">
          <Grid ColumnDefinitions="110,*,130,160,70,70">
            <TextBlock Text="{Binding Username}" />
            <TextBlock Grid.Column="1" Text="{Binding FullName}" />
            <TextBlock Grid.Column="2" Text="{Binding StatusText}" />
            <TextBlock Grid.Column="3" Text="{Binding SubmittedText}" />
            <TextBlock Grid.Column="4" Text="{Binding CorrectText}" />
            <TextBlock Grid.Column="5" Text="{Binding ScoreText}" FontWeight="SemiBold" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
