<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProgLab.InstructorApp.ViewModels"
             x:Class="ProgLab.InstructorApp.Views.LogsView"
             x:DataType="vm:LogsViewModel">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <TextBlock Classes="title" Text="Sınav Logları" />
      <WrapPanel IsVisible="{Binding IsTableVisible}">
        <ComboBox ItemsSource="{Binding EventTypes}" SelectedItem="{Binding SelectedEvent}" MinWidth="190" Margin="0,0,8,4" AutomationProperties.Name="Olay tipi" />
        <TextBox Text="{Binding StudentFilter}" PlaceholderText="Öğrenci no" Width="130" Margin="0,0,8,4" AutomationProperties.Name="Öğrenci no filtresi" />
        <TextBox Text="{Binding FromText}" PlaceholderText="Başlangıç (gg.aa.yyyy ss:dd)" Width="210" Margin="0,0,8,4" AutomationProperties.Name="Başlangıç zamanı" />
        <TextBox Text="{Binding ToText}" PlaceholderText="Bitiş (gg.aa.yyyy ss:dd)" Width="210" Margin="0,0,8,4" AutomationProperties.Name="Bitiş zamanı" />
        <Button Classes="accent" Content="Filtrele" Command="{Binding ApplyCommand}" Margin="0,0,0,4" AutomationProperties.Name="Filtrele" />
      </WrapPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
      <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsTableVisible}">
          <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Opacity="0.8" />
          <Button Content="Önceki" IsEnabled="{Binding CanGoBack}" Command="{Binding PreviousCommand}" AutomationProperties.Name="Önceki sayfa" />
          <Button Content="Sonraki" IsEnabled="{Binding CanGoNext}" Command="{Binding NextCommand}" AutomationProperties.Name="Sonraki sayfa" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Listeye dön" Command="{Binding BackCommand}" AutomationProperties.Name="Listeye dön" />
          <Button Content="Ham dosyayı göster" IsVisible="{Binding IsTableVisible}" Command="{Binding ShowRawCommand}" AutomationProperties.Name="Ham dosyayı göster" />
          <Button Content="Tabloya dön" IsVisible="{Binding IsRawVisible}" Command="{Binding ShowTableCommand}" AutomationProperties.Name="Tabloya dön" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <Grid>
      <TextBox IsVisible="{Binding IsRawVisible}" Text="{Binding RawText}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, monospace"
               TextWrapping="NoWrap" AutomationProperties.Name="Ham log dosyası" />
      <DockPanel IsVisible="{Binding IsTableVisible}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="150,150,110,150,110,*" Margin="12,0,12,4" Opacity="0.7">
          <TextBlock Text="Saat" />
          <TextBlock Grid.Column="1" Text="Olay" />
          <TextBlock Grid.Column="2" Text="Kullanıcı" />
          <TextBlock Grid.Column="3" Text="Ad soyad" />
          <TextBlock Grid.Column="4" Text="IP" />
          <TextBlock Grid.Column="5" Text="Açıklama" />
        </Grid>
        <ListBox ItemsSource="{Binding Rows}" AutomationProperties.Name="Log kayıtları">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogRow">
              <Grid ColumnDefinitions="150,150,110,150,110,*">
                <TextBlock Text="{Binding TimeText}" />
                <TextBlock Grid.Column="1" Text="{Binding EventType}" />
                <TextBlock Grid.Column="2" Text="{Binding Username}" />
                <TextBlock Grid.Column="3" Text="{Binding FullName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{Binding Ip}" />
                <TextBlock Grid.Column="5" Text="{Binding Text}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
