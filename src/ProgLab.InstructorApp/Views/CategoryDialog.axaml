<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProgLab.InstructorApp.ViewModels"
             x:Class="ProgLab.InstructorApp.Views.CategoryDialog"
             x:DataType="vm:CategoryDialogViewModel">
  <Border Width="400" Padding="20" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="#40808080" BorderThickness="1">
    <StackPanel Spacing="8">
      <TextBlock Classes="section" Text="{Binding Heading}" />
      <TextBlock Text="Kategori adı" />
      <TextBox Text="{Binding Name}" AutomationProperties.Name="Kategori adı" />
      <TextBlock Text="Üst kategori" />
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Parents}" SelectedItem="{Binding SelectedParent}" AutomationProperties.Name="Üst kategori">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CategoryOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Vazgeç" Command="{Binding CancelCommand}" AutomationProperties.Name="Kategoriden vazgeç" />
        <Button Classes="accent" Content="Kaydet" Command="{Binding SaveCommand}" AutomationProperties.Name="Kategoriyi kaydet" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
