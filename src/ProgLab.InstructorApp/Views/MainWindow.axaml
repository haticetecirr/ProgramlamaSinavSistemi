<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProgLab.InstructorApp.ViewModels"
        x:Class="ProgLab.InstructorApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,8" IsVisible="{Binding IsLoggedIn}"
            BorderBrush="#40808080" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Çıkış" Command="{Binding LogoutCommand}" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding UserName}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanNavigate}">
          <Button Content="Şubeler" Command="{Binding ShowClassesCommand}" AutomationProperties.Name="Şubeler" />
          <Button Content="Soru Bankası" Command="{Binding ShowQuestionBankCommand}" AutomationProperties.Name="Soru Bankası" />
        </StackPanel>
      </DockPanel>
    </Border>
    <ContentControl Content="{Binding CurrentPage}" />
  </DockPanel>
</Window>
