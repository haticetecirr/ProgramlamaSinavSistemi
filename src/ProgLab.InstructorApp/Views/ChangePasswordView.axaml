<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProgLab.InstructorApp.ViewModels"
             x:Class="ProgLab.InstructorApp.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">
  <StackPanel Width="360" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Classes="title" Text="Parolanızı Değiştirin" />
    <TextBlock Text="Geçici parolayla giriş yaptınız. Devam etmek için yeni bir parola belirleyin (en az 8 karakter)." TextWrapping="Wrap" />
    <TextBlock Text="Mevcut parola" />
    <TextBox Text="{Binding CurrentPassword}" PasswordChar="●" AutomationProperties.Name="Mevcut parola" />
    <TextBlock Text="Yeni parola" />
    <TextBox Text="{Binding NewPassword}" PasswordChar="●" AutomationProperties.Name="Yeni parola" />
    <TextBlock Text="Yeni parola (tekrar)" />
    <TextBox Text="{Binding NewPasswordRepeat}" PasswordChar="●" AutomationProperties.Name="Yeni parola tekrar" />
    <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <Button Classes="accent" Content="Parolayı değiştir" IsDefault="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
            Command="{Binding ChangeCommand}" AutomationProperties.Name="Parolayı değiştir" />
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding ChangeCommand.IsRunning}" />
  </StackPanel>
</UserControl>
